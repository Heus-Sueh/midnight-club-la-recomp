+          const float* ot = skinned ? latest.b.data() : &latest.w[12];
+          const float dx = skinned ? nt[3] - ot[3] : nt[0] - ot[0];
+          const float dy = skinned ? nt[7] - ot[7] : nt[1] - ot[1];
