+void ViewRotFromQuat(const float q[4], float view[16]) {
+  const float x = q[0], y = q[1], z = q[2], w = q[3];
+  view[0] = 1 - 2 * (y * y + z * z);
+  view[1] = 2 * (x * y - z * w);
+  view[2] = 2 * (x * z + y * w);
+  view[4] = 2 * (x * y + z * w);
+  view[5] = 1 - 2 * (x * x + z * z);
+  view[6] = 2 * (y * z - x * w);
+  view[8] = 2 * (x * z - y * w);
+  view[9] = 2 * (y * z + x * w);
+  view[10] = 1 - 2 * (x * x + y * y);
+}
