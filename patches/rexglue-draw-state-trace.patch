+uint64_t HashRegisterRange(const RegisterFile& regs, uint32_t first, uint32_t count) {
+  uint64_t hash = UINT64_C(14695981039346656037);
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t value = regs.values[first + i];
+    for (uint32_t byte_index = 0; byte_index < sizeof(value); ++byte_index) {
+      hash ^= uint8_t(value >> (byte_index * 8));
+      hash *= UINT64_C(1099511628211);
+    }
+  }
+  return hash;
+}
+
+void AppendIndexedWords(std::string& output, uint32_t index, const uint32_t* words,
+                        uint32_t word_count) {
+  if (!output.empty()) {
+    output.push_back(';');
+  }
+  fmt::format_to(std::back_inserter(output), "{}:", index);
+  for (uint32_t i = 0; i < word_count; ++i) {
+    fmt::format_to(std::back_inserter(output), "{:08X}", words[i]);
+  }
+}
+
+std::string GetUsedVertexFetches(const RegisterFile& regs, const Shader* shader) {
+  std::string output;
+  if (!shader || !shader->is_ucode_analyzed()) {
+    return output;
+  }
+  const Shader::ConstantRegisterMap& constant_map = shader->constant_register_map();
+  for (uint32_t block = 0; block < rex::countof(constant_map.vertex_fetch_bitmap); ++block) {
+    uint32_t remaining = constant_map.vertex_fetch_bitmap[block];
+    uint32_t bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(uint32_t(1) << bit);
+      const uint32_t index = block * 32 + bit;
+      const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(index);
+      AppendIndexedWords(output, index, &fetch.dword_0, 2);
+    }
+  }
+  return output;
+}
+
+std::string GetUsedTextureFetches(const RegisterFile& regs, const Shader* shader) {
+  std::string output;
+  if (!shader || !shader->is_ucode_analyzed()) {
+    return output;
+  }
+  uint32_t captured_mask = 0;
+  for (const Shader::TextureBinding& binding : shader->texture_bindings()) {
+    const uint32_t index = binding.fetch_constant;
+    const uint32_t bit = uint32_t(1) << index;
+    if (captured_mask & bit) {
+      continue;
+    }
+    captured_mask |= bit;
+    const xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(index);
+    uint32_t words[6];
+    std::memcpy(words, &fetch, sizeof(words));
+    AppendIndexedWords(output, index, words, rex::countof(words));
+  }
+  return output;
+}
+
+std::string GetUsedFloatConstants(const RegisterFile& regs, const Shader* shader,
+                                  uint32_t register_base) {
+  std::string output;
+  if (!shader || !shader->is_ucode_analyzed()) {
+    return output;
+  }
+  const Shader::ConstantRegisterMap& constant_map = shader->constant_register_map();
+  for (uint32_t block = 0; block < rex::countof(constant_map.float_bitmap); ++block) {
+    uint64_t remaining = constant_map.float_bitmap[block];
+    uint32_t bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(uint64_t(1) << bit);
+      const uint32_t index = block * 64 + bit;
+      AppendIndexedWords(output, index, &regs.values[register_base + index * 4], 4);
+    }
+  }
+  return output;
+}
+
