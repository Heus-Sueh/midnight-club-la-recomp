+void CommandProcessor::TraceDrawState(const char* opcode_name, xenos::PrimitiveType prim_type,
+                                      uint32_t index_count,
+                                      const IndexBufferInfo* index_buffer_info,
+                                      bool major_mode_explicit) {
+  const std::string& trace_path = REXCVAR_GET(gpu_draw_state_trace);
+  if (trace_path.empty()) {
+    return;
+  }
+
+  const uint64_t frame = draw_state_frame_;
+  const uint64_t start_frame = uint64_t(REXCVAR_GET(gpu_draw_state_trace_start_frame));
+  const uint64_t frame_count = uint64_t(REXCVAR_GET(gpu_draw_state_trace_frame_count));
+  if (frame < start_frame) {
+    return;
+  }
+
+  if (!draw_state_trace_) {
+    draw_state_trace_ = std::make_unique<DrawStateTrace>();
+  }
+  DrawStateTrace& trace = *draw_state_trace_;
+  if (trace.captured_frame_count >= frame_count) {
+    return;
+  }
+  if (!trace.file && !trace.open_failed) {
+    trace.file = rex::filesystem::OpenFile(rex::to_path(trace_path), "w");
+    if (!trace.file) {
+      trace.open_failed = true;
+      REXGPU_ERROR("Unable to open GPU draw-state trace output");
+      return;
+    }
+    std::fputs(
+        "frame,draw,opcode,primitive,index_count,indexed,index_format,index_endian,"
+        "index_guest_base,index_length,major_mode_explicit,vs_hash,ps_hash,fetch_hash,"
+        "float_hash,bool_loop_hash,rb_surface_info,rb_color_info0,rb_color_info1,"
+        "rb_color_info2,rb_color_info3,rb_depth_info,rb_color_mask,rb_colorcontrol,"
+        "rb_depthcontrol,rb_modecontrol,pa_sc_screen_tl,pa_sc_screen_br,"
+        "pa_sc_window_offset,pa_sc_window_tl,pa_sc_window_br,pa_cl_vport_xscale,"
+        "pa_cl_vport_xoffset,pa_cl_vport_yscale,pa_cl_vport_yoffset,"
+        "pa_cl_vport_zscale,pa_cl_vport_zoffset,sq_program_cntl,sq_context_misc,"
+        "pa_cl_clip_cntl,pa_su_sc_mode_cntl,pa_cl_vte_cntl,vgt_output_path_cntl,"
+        "vgt_hos_cntl,vertex_fetches,vs_texture_fetches,ps_texture_fetches,"
+        "vs_float_constants,ps_float_constants\n",
+        trace.file);
+    REXGPU_INFO(
+        "GPU draw-state trace started at or after guest frame {} for {} non-empty frame(s)",
+        start_frame, frame_count);
+  }
+  if (!trace.file) {
+    return;
+  }
+
+  if (trace.current_frame != frame) {
+    trace.current_frame = frame;
+    trace.frame_draw_index = 0;
+  }
+
+  const RegisterFile& regs = *register_file_;
+  const uint64_t vs_hash = active_vertex_shader_ ? active_vertex_shader_->ucode_data_hash() : 0;
+  const uint64_t ps_hash = active_pixel_shader_ ? active_pixel_shader_->ucode_data_hash() : 0;
+  const uint64_t fetch_hash =
+      HashRegisterRange(regs, XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0, 32 * 6);
+  const uint64_t float_hash =
+      HashRegisterRange(regs, XE_GPU_REG_SHADER_CONSTANT_000_X, 512 * 4);
+  uint64_t bool_loop_hash =
+      HashRegisterRange(regs, XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031, 8);
+  bool_loop_hash ^= HashRegisterRange(regs, XE_GPU_REG_SHADER_CONSTANT_LOOP_00, 32);
+
+  const uint32_t indexed = index_buffer_info ? 1 : 0;
+  const uint32_t index_format =
+      index_buffer_info ? uint32_t(index_buffer_info->format) : 0;
+  const uint32_t index_endian =
+      index_buffer_info ? uint32_t(index_buffer_info->endianness) : 0;
+  const uint32_t index_guest_base = index_buffer_info ? index_buffer_info->guest_base : 0;
+  const size_t index_length = index_buffer_info ? index_buffer_info->length : 0;
+  const std::string vertex_fetches = GetUsedVertexFetches(regs, active_vertex_shader_);
+  const std::string vs_texture_fetches = GetUsedTextureFetches(regs, active_vertex_shader_);
+  const std::string ps_texture_fetches = GetUsedTextureFetches(regs, active_pixel_shader_);
+  const std::string vs_float_constants = GetUsedFloatConstants(
+      regs, active_vertex_shader_, XE_GPU_REG_SHADER_CONSTANT_000_X);
+  const std::string ps_float_constants = GetUsedFloatConstants(
+      regs, active_pixel_shader_, XE_GPU_REG_SHADER_CONSTANT_256_X);
+
+  std::fprintf(
+      trace.file,
+      "%" PRIu64 ",%" PRIu64 ",%s,%u,%u,%u,%u,%u,%u,%zu,%u,0x%016" PRIX64
+      ",0x%016" PRIX64 ",0x%016" PRIX64 ",0x%016" PRIX64 ",0x%016" PRIX64
+      ",%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,"
+      "%u,%u,%u,%u,%u,%s,%s,%s,%s,%s\n",
+      frame, trace.frame_draw_index++, opcode_name, uint32_t(prim_type), index_count, indexed,
+      index_format, index_endian, index_guest_base, index_length,
+      uint32_t(major_mode_explicit), vs_hash, ps_hash, fetch_hash, float_hash, bool_loop_hash,
+      regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_COLOR_INFO],
+      regs[XE_GPU_REG_RB_COLOR1_INFO], regs[XE_GPU_REG_RB_COLOR2_INFO],
+      regs[XE_GPU_REG_RB_COLOR3_INFO], regs[XE_GPU_REG_RB_DEPTH_INFO],
+      regs[XE_GPU_REG_RB_COLOR_MASK], regs[XE_GPU_REG_RB_COLORCONTROL],
+      regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_MODECONTROL],
+      regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR],
+      regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], regs[XE_GPU_REG_PA_CL_VPORT_XSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_XOFFSET], regs[XE_GPU_REG_PA_CL_VPORT_YSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_YOFFSET], regs[XE_GPU_REG_PA_CL_VPORT_ZSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_ZOFFSET], regs[XE_GPU_REG_SQ_PROGRAM_CNTL],
+      regs[XE_GPU_REG_SQ_CONTEXT_MISC], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+      regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+      regs[XE_GPU_REG_VGT_OUTPUT_PATH_CNTL], regs[XE_GPU_REG_VGT_HOS_CNTL],
+      vertex_fetches.c_str(), vs_texture_fetches.c_str(), ps_texture_fetches.c_str(),
+      vs_float_constants.c_str(), ps_float_constants.c_str());
+  ++trace.row_count;
+}
+
+void CommandProcessor::FinishDrawStateTraceFrame() {
+  if (!draw_state_trace_ || !draw_state_trace_->file) {
+    return;
+  }
+
+  DrawStateTrace& trace = *draw_state_trace_;
+  const uint64_t frame = draw_state_frame_;
+  if (trace.current_frame != frame || trace.frame_draw_index == 0) {
+    return;
+  }
+  std::fflush(trace.file);
+  const uint64_t frame_count = uint64_t(REXCVAR_GET(gpu_draw_state_trace_frame_count));
+  ++trace.captured_frame_count;
+  if (trace.captured_frame_count >= frame_count) {
+    std::fclose(trace.file);
+    trace.file = nullptr;
+    REXGPU_INFO("GPU draw-state trace completed with {} draw(s) across {} non-empty frame(s)",
+                trace.row_count, trace.captured_frame_count);
+  }
+}
