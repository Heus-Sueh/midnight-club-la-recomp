+void SharedMemory::TracePhysicalRangeEvent(
+    const char* event, uint32_t range_start, uint32_t range_length,
+    uint32_t affected_start, uint32_t affected_length, bool hash_target) {
+  PhysicalRangeTrace* trace = physical_range_trace_.get();
+  if (!trace || !range_length) {
+    return;
+  }
+  const uint64_t range_end = uint64_t(range_start) + range_length;
+  const uint64_t target_end = uint64_t(trace->start) + trace->length;
+  if (range_start >= target_end || range_end <= trace->start) {
+    return;
+  }
+
+  uint64_t target_hash = 0;
+  if (hash_target) {
+    target_hash = UINT64_C(14695981039346656037);
+    const uint8_t* target = memory_.TranslatePhysical<const uint8_t*>(trace->start);
+    for (uint32_t i = 0; i < trace->length; ++i) {
+      target_hash ^= target[i];
+      target_hash *= UINT64_C(1099511628211);
+    }
+  }
+
+  std::lock_guard lock(trace->mutex);
+  const uint64_t sequence = trace->sequence++;
+  std::fprintf(trace->file,
+               "%" PRIu64 ",%s,0x%08X,%u,0x%08X,%u,0x%08X,%u,",
+               sequence, event, trace->start, trace->length,
+               range_start, range_length, affected_start, affected_length);
+  if (hash_target) {
+    std::fprintf(trace->file, "0x%016" PRIX64, target_hash);
+  }
+  std::fputc('\n', trace->file);
+  std::fflush(trace->file);
+  if (hash_target) {
+    REXGPU_INFO(
+        "Physical range trace event {}: {} range=0x{:08X}+{} "
+        "affected=0x{:08X}+{} target_hash=0x{:016X}",
+        sequence, event, range_start, range_length, affected_start,
+        affected_length, target_hash);
+  } else {
+    REXGPU_INFO(
+        "Physical range trace event {}: {} range=0x{:08X}+{} "
+        "affected=0x{:08X}+{}",
+        sequence, event, range_start, range_length, affected_start,
+        affected_length);
+  }
+}
