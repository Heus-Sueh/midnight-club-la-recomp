+/**
+ * @file        memory_mapping_test.cpp
+ * @brief       Unit tests for host file-backed memory mappings
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay
+ * @license     BSD 3-Clause License
+ */
+
+#include <cerrno>
+#include <cstdint>
+#include <string>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/memory/utils.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_LINUX || REX_PLATFORM_MAC
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+#if REX_PLATFORM_LINUX || REX_PLATFORM_MAC
+TEST_CASE("POSIX file mapping is anonymous after creation", "[memory][mapping]") {
+  const std::string name = "rexglue_mapping_test_" + std::to_string(getpid());
+  const std::string shm_name = "/" + name;
+  const size_t mapping_size = rex::memory::page_size();
+
+  // A failed earlier run must not affect this test.
+  shm_unlink(shm_name.c_str());
+
+  const auto handle = rex::memory::CreateFileMappingHandle(
+      name, mapping_size, rex::memory::PageAccess::kReadWrite, false);
+  REQUIRE(handle != rex::memory::kFileMappingHandleInvalid);
+
+  errno = 0;
+  const int reopened = shm_open(shm_name.c_str(), O_RDWR, 0);
+  CHECK(reopened == -1);
+  CHECK(errno == ENOENT);
+  if (reopened >= 0) {
+    close(reopened);
+  }
+
+  auto* view = static_cast<uint8_t*>(rex::memory::MapFileView(
+      handle, nullptr, mapping_size, rex::memory::PageAccess::kReadWrite, 0));
+  REQUIRE(view != nullptr);
+  view[0] = 0x52;
+  view[mapping_size - 1] = 0x58;
+  CHECK(view[0] == 0x52);
+  CHECK(view[mapping_size - 1] == 0x58);
+
+  CHECK(rex::memory::UnmapFileView(handle, view, mapping_size));
+  rex::memory::CloseFileMappingHandle(handle, name);
+}
+#endif
