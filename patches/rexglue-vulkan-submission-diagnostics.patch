+REXCVAR_DEFINE_BOOL(vulkan_submission_diagnostics, false, "GPU/Vulkan",
+                    "Log five-second Vulkan submission, fence wait, and queue-depth statistics")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 namespace rex::graphics::vulkan {
 
 namespace {
 
+struct SubmissionDiagnostics {
+  std::chrono::steady_clock::time_point interval_start{};
+  uint64_t submissions = 0;
+  uint64_t swaps = 0;
+  uint64_t blocking_fence_waits = 0;
+  uint64_t fences_blocked_on = 0;
+  uint64_t fences_completed = 0;
+  uint64_t fence_wait_ns = 0;
+  uint64_t deferred_execute_ns = 0;
+  uint64_t queue_submit_ns = 0;
+  uint64_t in_flight_sum = 0;
+  uint64_t in_flight_max = 0;
+
+  void Reset(std::chrono::steady_clock::time_point now) {
+    *this = {};
+    interval_start = now;
+  }
+};
+
+SubmissionDiagnostics* GetSubmissionDiagnostics() {
+  static SubmissionDiagnostics diagnostics;
+  if (!REXCVAR_GET(vulkan_submission_diagnostics)) {
+    diagnostics.interval_start = {};
+    return nullptr;
+  }
+  if (diagnostics.interval_start.time_since_epoch().count() == 0) {
+    diagnostics.Reset(std::chrono::steady_clock::now());
+  }
+  return &diagnostics;
+}
+
+void MaybeReportSubmissionDiagnostics(SubmissionDiagnostics& diagnostics,
+                                      uint64_t in_flight) {
+  const auto now = std::chrono::steady_clock::now();
+  const double elapsed_seconds = std::chrono::duration<double>(
+                                     now - diagnostics.interval_start)
+                                     .count();
+  if (elapsed_seconds < 5.0) {
+    return;
+  }
+  const double ns_to_ms = 1.0 / 1'000'000.0;
+  REXGPU_INFO(
+      "[VulkanSubmissionDiagnostics] elapsed_s={:.3f}, submissions={}, swaps={}, "
+      "submissions_per_s={:.1f}, in_flight_avg={:.2f}, in_flight_max={}, "
+      "blocking_fence_waits={}, fences_blocked_on={}, fences_completed={}, "
+      "fence_wait_ms={:.3f}, deferred_execute_ms={:.3f}, queue_submit_ms={:.3f}",
+      elapsed_seconds, diagnostics.submissions, diagnostics.swaps,
+      static_cast<double>(diagnostics.submissions) / elapsed_seconds,
+      diagnostics.submissions
+          ? static_cast<double>(diagnostics.in_flight_sum) / diagnostics.submissions
+          : static_cast<double>(in_flight),
+      diagnostics.in_flight_max, diagnostics.blocking_fence_waits,
+      diagnostics.fences_blocked_on, diagnostics.fences_completed,
+      static_cast<double>(diagnostics.fence_wait_ns) * ns_to_ms,
+      static_cast<double>(diagnostics.deferred_execute_ns) * ns_to_ms,
+      static_cast<double>(diagnostics.queue_submit_ns) * ns_to_ms);
+  diagnostics.Reset(now);
+}
